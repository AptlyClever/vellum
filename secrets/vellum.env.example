# Vellum host-managed secrets.
#
# Copy to `secrets/vellum.env` on the host and fill in the real values. That path is
# gitignored and is mounted by docker-compose via `env_file: required: false`, so a
# checkout without it still boots.
#
# Do NOT put these in `.env`. Compose reads `.env` for its own interpolation and never
# injects it into a container - a secret placed there reaches nothing.
#
# Do NOT add these keys to `environment:` in docker-compose.yml. Keys listed there
# override env_file, and `KEY: ${KEY:-}` exports an empty string when the host variable
# is unset, which would permanently shadow whatever is written here.

# --- OAuth 2.0 client credentials (Vellum -> Mneme) -------------------------
# Client `vellum` in Keycloak realm `control-alt`. The realm ships the placeholder
# `dev-only-vellum-CHANGE-ME`; the operator provisions the real secret on the press.
VELLUM_OAUTH_CLIENT_SECRET=dev-only-vellum-CHANGE-ME

# --- Deprecated -------------------------------------------------------------
# Static bearer for Mneme. Tier 2 of the ladder in backend/mneme.py: it fires only
# when the OAuth secret above is absent, and it logs a deprecation warning every time.
# Delete this line once OAuth is provisioned; the code will then be the only path.
MNEME_WRITE_TOKEN=

# Inbound gate for Vellum's own Visual Research mutations. Unrelated to OAuth; it
# lives here because it is a secret and this is now the file secrets arrive in.
VELLUM_RESEARCH_WRITE_TOKEN=

# --- Fleet Postgres (PX001) --------------------------------------------------
# backend/intake.py's IntakeRun ledger (deploy/postgres/migrations/vellum/
# 001__intake_runs.sql) AND backend/register.py's asset catalog
# (002__asset_register.sql) both live here. Password for role `vellum_writer`,
# provisioned on the press host at /etc/control-alt/pg/vellum.pgpass. Empty means
# "not configured": intake reads (list_runs/get_run) degrade to empty since
# they back informational surfaces, but intake writes AND all register
# reads/writes raise loudly rather than guess at trust/peer auth against a
# LAN-reachable database -- the asset catalog has no honest "empty" mode.
VELLUM_POSTGRES_PASSWORD=

# Same role/password, against the disposable control_alt_fleet_test database
# instead of prod. Only needed for the `test` compose profile
# (`docker compose --profile test run test`); local/CI pytest runs supply
# this per-invocation instead (see tests/conftest.py's pg_intake fixture).
VELLUM_TEST_POSTGRES_PASSWORD=
